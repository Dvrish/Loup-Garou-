# Facultatif : par défaut, le jeu utilise le projet Supabase indiqué dans src/lib/supabase.ts.
# Pour en utiliser un autre, définissez ces variables dans Netlify
# (Site configuration → Environment variables) ou dans un fichier .env local.
# Ne mettez JAMAIS la clé "service_role" : seule la clé publique "anon" est autorisée.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
