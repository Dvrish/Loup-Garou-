# Copiez ces variables dans Netlify (Site configuration → Environment variables).
# Elles serviront à partir de l'étape 4 (Supabase). Ne mettez JAMAIS la clé
# "service_role" ici ni dans Netlify : seule la clé publique "anon" est autorisée.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
